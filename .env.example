# Copy this file to .env and set real values.
POSTGRES_USER=grimoire
POSTGRES_DB=grimoire
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Model server (llama-server, OpenAI-compatible API)
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_API_KEY=change-me
LLAMA_MODEL=your-model.gguf

# Telegram bot token from BotFather.
# TELEGRAM_BOT_TOKEN=
# Numeric id of the club chat the bot serves.
# TELEGRAM_CLUB_CHAT_ID=
# Comma-separated numeric ids of users allowed to use the bot, e.g. 1,2,3.
# TELEGRAM_ALLOWED_USER_IDS=
